{
  "name": "docbridge",
  "version": "1.0.0",
  "description": "AI-powered English to Chinese technical documentation translator",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "build": "node scripts/build.mjs",
    "build:clean": "npm run clean && npm run build",
    "dev": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "tesseract.js": "^5.0.0"
  }
}
